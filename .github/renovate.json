{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "archive/**",
    "funland/talos/**",
    "funland/cnpg/cnpg-clusters/immich-cnpg-cluster.yaml"
  ],
  "prHourlyLimit": 6,
  "prConcurrentLimit": 10,
  "pruneStaleBranches": true,
  "argocd": {
    "managerFilePatterns": [
      "/funland/[^/]+/[^/]+/application\\.yaml/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/funland/[^/]+/[^/]+/deployment\\.yaml/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update app.kubernetes.io/version labels to match image versions",
      "managerFilePatterns": [
        "/^funland\\/.+\\/(deployment|service)\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*image=(?<depName>\\S+)\\n\\s*app\\.kubernetes\\.io/version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update image tags pinned inside ArgoCD Application helm values",
      "managerFilePatterns": [
        "/^funland\\/.+\\/application\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update CNPG cluster imageName references",
      "managerFilePatterns": [
        "/^funland\\/cnpg\\/cnpg-clusters\\/.+-cnpg-cluster\\.yaml$/"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Custom versioning for LinuxServer.io images",
      "matchPackagePatterns": [
        "^lscr\\.io/linuxserver/",
        "^linuxserver/"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:[.\\-r]+(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Group image updates with their version labels in same PR",
      "matchDatasources": ["docker"],
      "matchFileNames": ["funland/**"],
      "groupName": "{{depName}} version updates"
    },
    {
      "description": "Auto-merge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require PR review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
